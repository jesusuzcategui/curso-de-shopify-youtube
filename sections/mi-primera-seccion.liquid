{% if section.settings.title != blank %}
    <h2>{{ section.settings.title }}</h2>
{% endif %}



{% schema %}
{
    "name": "Mi primera seccion",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Mi titulo"
        },
        {
            "type": "textarea",
            "id": "subtitle",
            "label": "Subtitle",
            "default": "Mi subtitulo"
        }
    ],
    "presets": [
        {
            "name": "Mi primera seccion"
        }
    ]
}
{% endschema %}